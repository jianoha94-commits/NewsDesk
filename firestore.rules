rules_version = '2';
// 자이노하뉴스데스크 — Firestore 보안 규칙
// Firebase Console → Firestore Database → 규칙(Rules) 에 그대로 붙여넣으세요.
// 핵심: 누구나 읽을 수 있지만, 쓰기는 로그인한 본인만. IP 등 민감정보는 아예 저장하지 않음.

service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 닉네임만 보관. 본인만 쓰기 가능.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20;
    }

    // 닉네임 선점(고유성 보장). 본인 uid 로만 생성.
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // 댓글: 누구나 읽기, 로그인 본인만 작성, 작성자만 삭제.
    match /comments/{cid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;

      // 좋아요/싫어요: 사용자당 1개(문서 id = uid). 반대/취소는 본인만.
      match /reactions/{uid} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.type in ['like', 'dislike'];
        allow delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }
  }
}
